{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["codeceptjs", "node"],
    "baseUrl": "."
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "output"]
}
