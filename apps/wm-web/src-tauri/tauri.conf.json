{
  "productName": "WM Wiki",
  "version": "0.1.0",
  "identifier": "work.knowns.wm",
  "build": {
    "beforeDevCommand": "npx ng serve",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/browser"
  },
  "app": {
    "windows": [
      {
        "title": "WM",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
