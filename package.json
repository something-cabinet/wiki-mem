{
  "name": "wiki-mem",
  "private": true,
  "scripts": {
    "build": "cargo build -p wm-server && cd apps/wm-web && npx ng build",
    "build:server": "cargo build -p wm-server",
    "build:web": "cd apps/wm-web && npx ng build",
    "dev": "cd apps/wm-web && npm start",
    "serve": "cargo run -p wm-server -- --port 4090",
    "start": "oxmgr apply oxfile.toml",
    "test": "cargo test --workspace",
    "test:cli": "cargo test -p wm-core --test cli_test && cargo test -p wm-core --test mcp_test",
    "e2e": "cd apps/wm-web-e2e && npm run test:e2e",
    "e2e:start": "oxmgr apply oxfile.toml --only mock,web-e2e",
    "e2e:stop": "oxmgr stop mock web-e2e 2>/dev/null",
    "mcp": "cargo run -p wm-cli mcp"
  }
}
